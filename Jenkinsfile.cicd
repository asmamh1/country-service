pipeline {
    agent any
    tools {
        maven 'M2_HOME'
    }
    stages {
        // GitHub --(Pull Code)--> Jenkins
        stage('Checkout code') {
            steps {
                checkout scm
            }
        }
        // Jenkins --(Build Code)--> Maven
        stage('Build (Maven)') {
            steps {
                sh 'mvn clean compile'
            }
        }
        // Maven --(Test code)--> JUnit
        stage('Test (JUnit)') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }
        // Jenkins --(analyse code)--> SonarQube
        stage('SonarQube analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=country-service -Dsonar.projectName=country-service'
                }
            }
        }
        // Maven fabrique le .jar (utilisé par le Dockerfile)
        stage('Package (Maven)') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }
        // Jenkins --(Continuous Delivery)--> Ansible
        //   Ansible --(Push Image)--> Docker Hub
        //   Ansible --(Deployment)--> Kubernetes --(Pull Image)--> Docker Hub
        stage('Deploy (Ansible -> Docker Hub -> Kubernetes)') {
            steps {
                sh 'ansible-playbook -i hosts playbookCICD.yml --vault-password-file /var/lib/jenkins/.vault_pass -e build_number=$BUILD_NUMBER'
            }
        }
    }
    post {
        success { echo 'Pipeline CI/CD terminé avec succès' }
        failure { echo 'Le pipeline a échoué' }
    }
}
