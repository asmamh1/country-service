pipeline {
    agent any

    tools {
        maven 'M2_HOME'
    }

    environment {
        DOCKER_USER = 'dockerhub-pwd'   
        IMAGE_NAME  = 'my-country-service'
    }

    stages {
        stage('Checkout code') {
            steps {
                git branch: 'master', url: 'https://github.com/asmamh1/country-service.git'
            }
        }

        stage('Build maven') {
            steps {
                sh 'mvn clean install'
            }
        }

        stage('Build Dockerfile') {
            steps {
                sh 'docker build . -t ${IMAGE_NAME}:${BUILD_NUMBER}'
                withCredentials([string(credentialsId: 'dockerhub-pwd', variable: 'dockerhubpwd')]) {
                    sh 'echo ${dockerhubpwd} | docker login -u ${DOCKER_USER} --password-stdin'
                }
                sh 'docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${DOCKER_USER}/${IMAGE_NAME}:${BUILD_NUMBER}'
                sh 'docker push ${DOCKER_USER}/${IMAGE_NAME}:${BUILD_NUMBER}'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    kubeconfig(credentialsId: 'kubeconfig-file', serverUrl: '') {
                        sh 'sed -i "s|BUILD_TAG|${BUILD_NUMBER}|; s|TON_DOCKER_ID|${DOCKER_USER}|" deployment.yaml'
                        sh 'kubectl apply -f deployment.yaml'
                        sh 'kubectl apply -f service.yaml'
                    }
                }
            }
        }
    }
}
