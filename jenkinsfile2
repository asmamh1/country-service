pipeline {
    agent any

    tools {
        maven 'M2_HOME'
    }

    environment {
        DOCKER_USER = 'dockerhub-pwd'   
        IMAGE_NAME  = 'my-country-service'
    }

    stages {
        stage('Checkout code') {
            steps {
                git branch: 'master', url: 'https://github.com/asmamh1/country-service.git'
            }
        }

        stage('Build maven') {
            steps {
                sh 'mvn clean install'
            }
        }

        stage('Build Dockerfile') {
            steps {
                sh 'docker build . -t my-country-service-deployement:$BUILD_NUMBER'
                withCredentials([string(credentialsId: 'dockerhub-pwd', variable: 'dockerhubpwd')]) {
                    sh 'echo ${dockerhubpwd} | docker login -u asmamh --password-stdin'
                }
                sh 'docker tag ${IMAGE_NAME}:${BUILD_NUMBER} asmamh/$my-country-service-deployement:$BUILD_NUMBER'
                sh 'docker push asmamh/my-country-service-deployement:$BUILD_NUMBER'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    kubeconfig(credentialsId: 'kubeconfig-file', serverUrl: '') {
                        sh 'kubectl apply -f deployment.yaml'
                        sh 'kubectl apply -f service.yaml'
                    }
                }
            }
        }
    }
}
