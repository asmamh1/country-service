pipeline {
    agent any
    tools {
        maven 'M2-HOME'
    }
    stages {
        stage('Checkout code')
        {
            steps {
                git branch: 'master', url: 'https://github.com/asmamh1/country-service.git'
            }
        }
        stage('Build maven')
        {
            steps {
                sh 'mvn clean install'
            }
        }
        stage('Build Dockerfile ')
        {
            steps {
                sh 'docker build . -t my-country-service:$BUILD_NUMBER '
                withCredentials([
                    string(
                        credentialsId: 'dockerhub-token',
                        variable: 'dockerhubpwd'
                    )
                ]) {
                sh '''
                    set +x
                    printf '%s' "$dockerhubpwd" |
                        docker login --username asmamh --password-stdin
                '''
            }
                
            sh '''
                docker tag my-country-service:4 asmamh/my-country-service:4
                docker push asmamh/my-country-service:4
            '''

            }
        }
        stage('Deploy micro-service')
        {
            steps {
                sh 'docker rm -f $(docker ps -aq)'
                sh 'docker run -d -p 8082:8082 my-country-service:$BUILD_NUMBER'
            }
        }
    }
}
